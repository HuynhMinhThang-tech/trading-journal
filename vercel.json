{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/gmail-sync?run=night", "schedule": "30 22 * * *" },
    { "path": "/api/cron/gmail-sync?run=noon", "schedule": "0 11 * * *" }
  ]
}
